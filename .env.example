# ─────────────── Database (free options: local Postgres, Docker, or Neon/Supabase cloud) ───────────────
# Docker (docker-compose): postgresql://techforge:techforge@localhost:5432/techforge
# Neon (free cloud):        postgresql://user:pass@ep-xxx.aws.neon.tech/techforge?sslmode=require
DATABASE_URL="postgresql://techforge:techforge@localhost:5432/techforge?schema=public"

# ─────────────── API ───────────────
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─────────────── Auth (generate strong random strings for production) ───────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─────────────── Storage (local now; s3 later) ───────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# ─────────────── AI (100% optional — app works fully without any key) ───────────────
# Leave AI_DRIVER=none for the free, key-less deterministic assistant.
# Free LLM options for narration: groq | gemini | ollama | openai-compatible
AI_DRIVER=none
# For OpenAI-compatible / Groq (free tier at https://console.groq.com):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# ─────────────── Web (apps/web/.env) ───────────────
# VITE_API_URL=http://localhost:4000/api/v1

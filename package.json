{
  "name": "techforge-erp",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Manufacturing ERP + MES for TechForge Manufacturing Pvt. Ltd.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run start --workspace @techforge/api",
    "check": "npm run typecheck && node scripts/check-syntax.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/unit/*.test.js",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/unit/*.test.js",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @techforge/api",
    "dev:web": "npm run dev --workspace @techforge/web",
    "build": "npm run build --workspace @techforge/shared && npm run build --workspace @techforge/api && npm run build --workspace @techforge/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @techforge/api",
    "db:migrate": "npm run db:migrate --workspace @techforge/api",
    "db:seed": "npm run db:seed --workspace @techforge/api",
    "db:reset": "npm run db:reset --workspace @techforge/api",
    "setup": "npm install && npm run db:generate"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tsx": "^4.17.0"
  }
}

// TechForge ERP + MES — Prisma schema
// Phase 1 scope: tenancy, auth, RBAC, audit. Later phases extend this file
// (master data, inventory, sales, production/MES, quality, purchasing, finance, HR).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ────────────────────────── Tenancy ──────────────────────────
model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  taxId     String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  roles        Role[]
  activityLogs ActivityLog[]

  customers      Customer[]
  suppliers      Supplier[]
  products       Product[]
  rawMaterials   RawMaterial[]
  warehouses     Warehouse[]
  boms           Bom[]
  stock          Stock[]
  stockMovements StockMovement[]

  machines         Machine[]
  employees        Employee[]
  inquiries        Inquiry[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  payments         Payment[]
  inspections      Inspection[]
  productionOrders ProductionOrder[]
}

/// ────────────────────────── Auth & RBAC ──────────────────────────
model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  @@unique([companyId, email])
  @@index([companyId])
}

model Role {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique // e.g. "order:read"
  resource String
  action   String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// ────────────────────────── Audit ──────────────────────────
model ActivityLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // CREATE, UPDATE, DELETE, STATE_CHANGE, LOGIN, LOGOUT
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([companyId, entityType])
  @@index([companyId, createdAt])
}

/// ────────────────────────── Master Data ──────────────────────────
model Customer {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  gstin          String?
  billingAddress String?
  city           String?
  state          String?
  creditLimit    Float     @default(0)
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  inquiries   Inquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Supplier {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  gstin         String?
  address       String?
  city          String?
  state         String?
  leadTimeDays  Int       @default(7)
  rating        Int?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Product {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  description  String?
  category     String?
  unit         String    @default("pcs")
  unitPrice    Float     @default(0)
  reorderPoint Float     @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  boms             Bom[]
  productionOrders ProductionOrder[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model RawMaterial {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String
  category     String?
  unit         String    @default("pcs")
  unitCost     Float     @default(0)
  reorderPoint Float     @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bomComponents BomComponent[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  location  String?
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stock          Stock[]
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// ────────────────────────── Bill of Materials ──────────────────────────
model Bom {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  version   String    @default("v1")
  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  components BomComponent[]

  @@index([companyId, productId])
}

model BomComponent {
  id            String      @id @default(cuid())
  bomId         String
  bom           Bom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantity      Float
  scrapPct      Float       @default(0)

  @@index([bomId])
  @@index([rawMaterialId])
}

/// ────────────────────────── Inventory ──────────────────────────
enum ItemType {
  PRODUCT
  RAW_MATERIAL
}

enum StockReason {
  OPENING
  PURCHASE_RECEIPT
  PRODUCTION_OUTPUT
  PRODUCTION_CONSUME
  SALE_DISPATCH
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

model Stock {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemType    ItemType
  itemId      String
  quantity    Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, itemType, itemId])
  @@index([companyId, itemType, itemId])
}

model StockMovement {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId  String
  warehouse    Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemType     ItemType
  itemId       String
  delta        Float
  balanceAfter Float
  reason       StockReason
  refType      String?
  refId        String?
  note         String?
  createdById  String?
  createdAt    DateTime    @default(now())

  @@index([companyId, itemType, itemId])
  @@index([companyId, createdAt])
}

/// ────────────────────────── Phase 3–6 transactional entities ──────────────────────────
model Machine {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      String?
  status    String    @default("IDLE") // IDLE, RUNNING, DOWN, MAINTENANCE
  location  String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])
  @@index([companyId])
}

model Employee {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  firstName     String
  lastName      String
  department    String?
  designation   String?
  email         String?
  phone         String?
  dateOfJoining DateTime?
  status        String    @default("ACTIVE") // ACTIVE, ON_LEAVE, EXITED
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([companyId, code])
  @@index([companyId])
}

model Inquiry {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number       String
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  subject      String
  status       String    @default("OPEN") // OPEN, QUOTED, WON, LOST
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}

model Quotation {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number     String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  status     String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  validUntil DateTime?
  subtotal   Float     @default(0)
  taxPct     Float     @default(18)
  total      Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}

model SalesOrder {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number     String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  status     String    @default("CONFIRMED") // CONFIRMED, IN_PRODUCTION, DISPATCHED, CLOSED, CANCELLED
  orderDate  DateTime  @default(now())
  total      Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}

model PurchaseOrder {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number     String
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  status     String    @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED
  orderDate  DateTime  @default(now())
  total      Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}

model Invoice {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  status      String    @default("ISSUED") // ISSUED, PARTIAL, PAID, OVERDUE, CANCELLED
  invoiceDate DateTime  @default(now())
  dueDate     DateTime?
  total       Float     @default(0)
  amountPaid  Float     @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}

model Payment {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  amount      Float
  method      String    @default("BANK") // BANK, CASH, UPI, CHEQUE
  paymentDate DateTime  @default(now())
  reference   String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}

model Inspection {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    String
  type      String    @default("INCOMING") // INCOMING, IN_PROCESS, FINAL
  status    String    @default("PENDING") // PENDING, PASSED, FAILED
  result    String?
  reference String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}

model ProductionOrder {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Float
  status      String    @default("PLANNED") // PLANNED, RELEASED, IN_PROGRESS, COMPLETED, CANCELLED
  plannedDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, number])
  @@index([companyId])
}
